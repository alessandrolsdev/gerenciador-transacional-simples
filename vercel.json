{
    "version": 2,
    "builds": [
        {
            "src": "server.js",
            "use": "@vercel/node"
        },
        {
            "src": "frontend/client/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "build"
            }
        }
    ],
    "routes": [
        {
            "src": "/graphql",
            "dest": "/server.js"
        },
        {
            "src": "/(.*)",
            "dest": "/frontend/client/$1"
        }
    ]
}